# A merge of every vendor EC/WMI driver as modules (=m).
# This used to be a separate matrix axis (10 variants) — but since
# they're all =m anyway, and modules_install is skipped, they don't
# affect the bzImage at all. Now it's one fixed fragment with
# support for every vendor at once, instead of a 10x duplication of vmlinux.
CONFIG_ACER_WMI=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_ACPI_WMI=m
CONFIG_DCDBAS=m
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_WMI=m
CONFIG_DELL_WMI_DDV=m
CONFIG_DELL_LAPTOP=m
CONFIG_HP_WMI=m
CONFIG_LG_LAPTOP=m
CONFIG_HUAWEI_WMI=m
CONFIG_THINKPAD_LMI=m
CONFIG_THINKPAD_ACPI=m
CONFIG_IDEAPAD_LAPTOP=m
CONFIG_MSI_LAPTOP=m
CONFIG_MSI_WMI=m
CONFIG_SAMSUNG_LAPTOP=m
CONFIG_SYSTEM76_ACPI=m
CONFIG_TOSHIBA_WMI=m
