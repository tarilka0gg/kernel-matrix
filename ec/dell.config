# Dell: the menuconfig gate + at least one SMBIOS backend (otherwise DELL_WMI/DELL_LAPTOP don't show up).
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_ACPI_WMI=m
CONFIG_DCDBAS=m
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_WMI=m
CONFIG_DELL_WMI_DDV=m
CONFIG_DELL_LAPTOP=m
