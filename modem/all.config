# A merge of every modem driver as modules (=m) — the same logic
# as ec/all.config: the modem axis doesn't affect the bzImage with
# --skip-modules, so it's one fixed fragment with every variant.
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_QUALCOMM=m
CONFIG_USB_SERIAL_SIERRAWIRELESS=m
CONFIG_MHI_BUS=m
CONFIG_MHI_WWAN_CTRL=m
CONFIG_MHI_WWAN_MBIM=m
CONFIG_MHI_NET=m
# gate: MHI_WWAN_* live under net/wwan, gated by if WWAN
CONFIG_WWAN=m
