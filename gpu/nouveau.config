# The open alternative NVIDIA driver (instead of the proprietary
# x11-drivers/nvidia-drivers from gpu/nvidia.config).
CONFIG_DRM=y
CONFIG_DRM_NOUVEAU=m

# Hybrid: the laptop panel is usually on the iGPU — the iGPU driver is needed here too.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_FBDEV_EMULATION=y
