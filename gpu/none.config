# No vendor-specific GPU fragment: the universal kernel. Every open DRM driver is built as a module
# (Intel i915/xe, AMD amdgpu/radeon, NVIDIA nouveau); the one that matches the hardware loads, and
# userspace Mesa works with any of them. NVIDIA's proprietary driver is not covered (see gpu/nvidia).
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_FBDEV_EMULATION=y
