# Discrete/hybrid NVIDIA through the proprietary x11-drivers/nvidia-drivers.
# Nouveau is NOT force-disabled here — on Optimus laptops it often drives
# the second (iGPU) output; if you specifically need DRM master handed to
# the owner, make a separate platform fragment with CONFIG_DRM_NOUVEAU disabled.
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y

# Optimus/hybrid: the laptop panel is usually wired to the iGPU, not to NVIDIA.
# Without the iGPU driver, all that's left is simpledrm/efifb (no acceleration, no
# brightness control/HDMI routing). Modules — only what's actually present gets loaded.
# DRM_KMS_HELPER/DRM_TTM_HELPER for nvidia-drivers come in via a select from these.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSVIPC=y
CONFIG_X86_PAT=y
