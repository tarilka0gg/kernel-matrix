# A safe fallback with no tie to a specific CPU — the same choice
# as for raptorlake/alderlake/znver3 at the kernel level (v3 = AVX2 baseline);
# the only difference is in the userspace profile's CFLAGS (no -march=<specific> here).
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
# CONFIG_X86_NATIVE_CPU is not set
# CONFIG_MZEN4 is not set
# Vendor unknown: pinctrl-amd is built-in only (a bool option, never a module); ~a few KB.
CONFIG_PINCTRL_AMD=y
