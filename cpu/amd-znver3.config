# Zen 3 — there's no separate MZEN3 in this tree; the AVX2 ceiling (v3) covers it correctly.
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
# CONFIG_X86_NATIVE_CPU is not set
# CONFIG_MZEN4 is not set
# AMD touchpad: GPIO controller (IRQ) — built-in, so it doesn't depend on module load order.
CONFIG_PINCTRL_AMD=y
# The I2C bus shared with the PSP (without this the touchpad doesn't start on some Zen2/3):
# gate: without it CRYPTO_DEV_CCP/SP_PSP are invisible
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_CCP=y
CONFIG_CRYPTO_DEV_CCP_DD=y
CONFIG_CRYPTO_DEV_SP_PSP=y
CONFIG_I2C_DESIGNWARE_AMDPSP=y
# AMD IOMMU: needed by the PSP chain (CRYPTO_DEV_SP_PSP depends on it) and DMA remapping on Zen.
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
