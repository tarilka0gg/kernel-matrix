# Kbuild does not use AVX-512 even if the CPU supports it — at the
# KERNEL level this profile gives the same binary as the other v2/v3 targets. The
# real difference (-march) is only in the userspace profile profiles/cpu/intel-arrowlake/.
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
# CONFIG_X86_NATIVE_CPU is not set
# CONFIG_MZEN4 is not set
