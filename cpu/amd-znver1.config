# Kbuild does not use AVX-512 even if the CPU supports it (comment
# in arch/x86/Kconfig.cpu: "x86-64-v4 is not included since the kernel
# does not use AVX512 instructions") — so at the KERNEL level this profile
# gives the same binary as the other v3 targets. The real difference (-march) —
# is only in the userspace profile profiles/cpu/amd-znver1/.
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
# CONFIG_X86_NATIVE_CPU is not set
# CONFIG_MZEN4 is not set
# AMD touchpad: GPIO controller (IRQ) — built-in, so it doesn't depend on module load order.
CONFIG_PINCTRL_AMD=y
# AMD IOMMU: needed by the PSP chain (CRYPTO_DEV_SP_PSP depends on it) and DMA remapping on Zen.
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
