# Shared hardware baseline for ANY platform (laptop/desktop/handheld/server).
# Pulled in automatically together with base.config (common/*.config).
#
# WHY THIS IS A SEPARATE FILE. Fragments layer on top of the seed, and the seed is a
# trim config for one specific laptop (Victus 16): everything it doesn't have is
# DISABLED there. Without this file, the generated kernels would "silently" lack a
# touchpad bus driver, Intel Ethernet, MediaTek Wi-Fi, an SD reader, and so on. This
# file is mostly modules (=m), aside from a few gate options; vmlinux barely grows,
# and only what's actually in the hardware gets loaded.
#
# IMPORTANT: run verify-fragments.sh after any change — `olddefconfig` silently
# drops options with unsatisfiable dependencies, and merge_config -m says nothing about it.

# ── Touchpad/touchscreen bus (I2C-HID, SPI, GPIO) ───────────────────────────────
# Without MFD_INTEL_LPSS_PCI, the Intel Serial IO I2C controller (PCI, 8086:xxxx)
# is left WITHOUT a driver -> an I2C-HID touchpad is dead (no input device
# shows up at all). This is the most common cause of "the kernel booted, the touchpad doesn't work".
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_INTEL_IDMA64=m
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_PIIX4=m
CONFIG_I2C_I801=m
# The touchpad needs a GPIO controller for its IRQ. Intel — here (modules); AMD (pinctrl-amd,
# the PSP I2C semaphore) — in cpu/amd-*.config, so built-ins don't grow the Intel vmlinux.
CONFIG_PINCTRL_INTEL_PLATFORM=m
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_PINCTRL_METEORPOINT=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_JASPERLAKE=m
CONFIG_PINCTRL_ELKHARTLAKE=m
CONFIG_PINCTRL_SUNRISEPOINT=m
CONFIG_PINCTRL_CANNONLAKE=m
CONFIG_PINCTRL_LAKEFIELD=m
CONFIG_PINCTRL_GEMINILAKE=m
CONFIG_PINCTRL_BROXTON=m
CONFIG_PINCTRL_CEDARFORK=m
# SPI bus (some touchpads/keyboards are on SPI, not I2C).
CONFIG_SPI_INTEL_PCI=m
CONFIG_SPI_INTEL_PLATFORM=m
CONFIG_SPI_PXA2XX=m
# Intel THC (Lunar/Arrow/Panther Lake): touchpads/touchscreens via QuickI2C/QuickSPI.
CONFIG_INTEL_THC_HID=m
CONFIG_INTEL_QUICKI2C=m
CONFIG_INTEL_QUICKSPI=m
# HID layer for touchpad/keyboards/BT-HID.
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_RMI=m
CONFIG_RMI4_CORE=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_SMB=m
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_RMI4_F3A=y
CONFIG_MOUSE_SYNAPTICS_I2C=m
CONFIG_HID_ASUS=m
CONFIG_HID_LENOVO=m
CONFIG_HID_APPLE=m
CONFIG_UHID=m
# Sensor hub (auto-rotate, lid sensor, ALS).
CONFIG_HID_SENSOR_HUB=m
CONFIG_INTEL_ISH_HID=m
CONFIG_INTEL_ISH_FIRMWARE_DOWNLOADER=m
CONFIG_AMD_SFH_HID=m

# ── Wired networking (the NET_VENDOR_* gates are off in the trim seed) ────────────────
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_RTL8152=m

# ── Wi-Fi / Bluetooth (self-contained: handheld/desktop don't get platform/laptop) ──
CONFIG_RFKILL=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8922AE=m
CONFIG_ATH12K=m
CONFIG_RFKILL_INPUT=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_BNEP=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m

# ── Audio: HDA codecs, SOF (Intel), ACP (AMD), speaker amplifiers ──────────
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_CS8409=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_SOF_PANTHERLAKE=m
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_ICELAKE=m
CONFIG_SND_SOC_SOF_COMETLAKE=m
CONFIG_SND_SOC_SOF_APOLLOLAKE=m
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m
CONFIG_SND_SOC_INTEL_MACH=y
# without this the SoundWire machine driver doesn't build (and UCM profiles need long card names)
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m
CONFIG_SND_SOC_INTEL_SOF_ES8336_MACH=m
CONFIG_SND_SOC_INTEL_SOF_RT5682_MACH=m
CONFIG_SND_SOC_INTEL_SOF_CS42L42_MACH=m
CONFIG_SND_SOC_INTEL_SOF_SSP_AMP_MACH=m
CONFIG_SND_SOC_AMD_ACP_COMMON=m
CONFIG_SND_SOC_AMD_ACP_PCI=m
CONFIG_SND_SOC_AMD_ACP6x=m
CONFIG_SND_SOC_AMD_YC_MACH=m
CONFIG_SND_SOC_AMD_PS=m
CONFIG_SND_SOC_AMD_PS_MACH=m
CONFIG_SND_SOC_AMD_RENOIR=m
CONFIG_SND_SOC_AMD_RENOIR_MACH=m
CONFIG_SND_AMD_ACP_CONFIG=m
# Speaker amplifiers on modern laptops (Lenovo/ASUS/Dell) — without them
# audio only works through headphones. The Victus fragment disables them for 8C99 separately.
CONFIG_SND_SOC_CS35L41_I2C=m
CONFIG_SND_SOC_CS35L41_SPI=m
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=m
CONFIG_SND_HDA_SCODEC_CS35L41_SPI=m
CONFIG_SND_HDA_SCODEC_CS35L56_I2C=m
CONFIG_SND_HDA_SCODEC_CS35L56_SPI=m
CONFIG_SND_HDA_SCODEC_TAS2781_I2C=m
CONFIG_SND_HDA_SCODEC_TAS2781_SPI=m

# ── Card readers, storage, USB ────────────────────────────────────────────────
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_SDHCI_ACPI=m
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MISC_RTSX_USB=m
CONFIG_MMC_REALTEK_USB=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m

# ── Power/thermal/performance profiles ──────────────────────────────────
CONFIG_ACPI_PLATFORM_PROFILE=m
CONFIG_INT340X_THERMAL=m
CONFIG_INT3406_THERMAL=m
CONFIG_ACPI_THERMAL_REL=m
CONFIG_PROC_THERMAL_MMIO_RAPL=m
CONFIG_INTEL_TCC_COOLING=m
CONFIG_AMD_PMC=m
CONFIG_AMD_3D_VCACHE=m

# ── Filesystems: mounting the ESP (vfat with iocharset=iso8859-1/utf8) ────────
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_UTF8=m
CONFIG_NLS_CODEPAGE_437=m
