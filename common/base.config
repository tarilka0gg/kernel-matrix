# Shared baseline for ANY hardware in this distro.
# Only things that don't depend on the specific machine go here. Hardware-specific
# stuff (Wi-Fi chip, audio, touchpad controller, etc) does NOT belong here — for
# that, make a separate platform/<model>.config following the trim9/10/11 example
# from victus-unlock (that's also where the method for spotting "dead" options that
# `make olddefconfig` silently reverts lives: see the symbol-case pitfall
# in scripts/config, journal.md).
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
