# x86 game consoles/handhelds (Steam Deck-like, ROG Ally, etc):
# battery and suspend like a laptop, plus a game controller, no laptop-style
# backlight (there it's more often an amdgpu panel, not a separate ACPI backlight).
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_SUSPEND=y
CONFIG_HID_STEAM=m
CONFIG_JOYSTICK_XPAD=m
