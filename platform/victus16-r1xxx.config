# HP Victus 16-r1xxx (i7-14650HX + RTX 4070 Max-Q, board 8C99).
# Carried over from victus-tuning (the system-lab repo) — the trim10/trim11 method,
# verified build+boot. This is an example of a platform fragment "for a specific
# model" layered on top of the shared cpu/intel-raptorlake.config + gpu/nvidia.config
# + platform/laptop.config + ec/hp.config (HP_WMI comes from there, not from here).
CONFIG_RTW89_CORE=m

# The MT76 family (MediaTek Wi-Fi) — not present on this board, real Wi-Fi
# goes through rtw89. WARNING: symbols like MT76x0U/MT76x02_LIB have MIXED
# case in Kconfig — scripts/config without --keep-case (-k) uppercases the
# option name and silently targets a nonexistent symbol, leaving the real one enabled.
# See journal.md, the "MT76_CORE unresolved" episode.
# CONFIG_MT76_CORE is not set
# CONFIG_MT76_USB is not set
# CONFIG_MT76x0U is not set
# CONFIG_MT76x0_COMMON is not set
# CONFIG_MT76x2U is not set
# CONFIG_MT76x2_COMMON is not set
# CONFIG_MT76x02_LIB is not set
# CONFIG_MT76x02_USB is not set
# CONFIG_MT7921_COMMON is not set
# CONFIG_MT7921U is not set
# CONFIG_MT7925_COMMON is not set
# CONFIG_MT7925U is not set

# Cirrus Logic CS35L41/CS35L56 (ASoC + HDA side-codec paths) — on board
# 8C99 the speakers go through a different codec, these modules are dead weight.
# CONFIG_SND_SOC_CS35L41 is not set
# CONFIG_SND_SOC_CS35L41_SPI is not set
# CONFIG_SND_SOC_CS35L41_I2C is not set
# CONFIG_SND_HDA_SCODEC_CS35L41_I2C is not set
# CONFIG_SND_HDA_SCODEC_CS35L41_SPI is not set
# CONFIG_SND_SOC_CS35L56_SHARED is not set
# CONFIG_SND_HDA_SCODEC_CS35L56_I2C is not set
# CONFIG_SND_HDA_SCODEC_CS35L56_SPI is not set
# CONFIG_SND_HDA_SCODEC_TAS2781_I2C is not set
# CONFIG_SND_HDA_SCODEC_TAS2781_SPI is not set

# Sources of "resurrection" for the codecs/MT76 disabled above (they're pulled in via select
# by common/hardware.config: MT7921E/MT7925E and the SOF SoundWire/SSP-AMP machine drivers).
# On board 8C99 audio goes through sof-hda-dsp (HDA), there are no SoundWire codecs.
# CONFIG_MT7921E is not set
# CONFIG_MT7925E is not set
# CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH is not set
# CONFIG_SND_SOC_INTEL_SOF_SSP_AMP_MACH is not set
