# Desktop — no laptop-related overhead (battery/hibernate are pointless here),
# instead full PCIe hotplug (expansion cards) and on-board
# sensors. BACKLIGHT_CLASS_DEVICE is deliberately NOT touched: the GPU drivers
# (amdgpu/i915) force it back on via select, and a forced --disable
# leaves it builtin+module at once -> modpost "exported twice" on
# EVERY desktop+gpu combination (the same pattern as MT76x0U — another
# option forcing a select around the explicit disable).
# CONFIG_ACPI_BATTERY is not set
# CONFIG_HIBERNATION is not set
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_CORETEMP=m
