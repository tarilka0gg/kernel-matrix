# Options common to any laptop — specific WMI/EC drivers for an
# exact model (like HP_WMI for the Victus 16) go in a separate platform/<model>.config.
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_RFKILL=m
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y

# Touchpad — without this a laptop is barely usable. I2C_HID covers most
# modern ones (Precision Touchpad), the PS/2 chain + Synaptics/ALPS/Elan —
# older/cheaper ones. All as modules, doesn't affect vmlinux.
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_MOUSE_PS2=m
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_ELAN_I2C=m

# Typical Wi-Fi chips in laptops (Intel/Realtek/Atheros/Broadcom) — without
# knowing the specific model there's no guessing the exact chip, so we take the
# whole popular set as modules at once; only what's actually present gets loaded.
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852CE=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
